<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>MovieApp | Register</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <nav>
    <a href="/" class="logo">🎬 MovieApp</a>
    <div class="nav-links">
      <a href="/login">Login</a>
    </div>
  </nav>

  <div class="container">
    <div class="card">
      <h2>Create Account</h2>
      <p>Join the movie community today.</p>
      <form action="/users/register" method="POST">
        <input type="text" name="name" placeholder="Full Name" required>
        <input type="email" name="email" placeholder="Email Address" required>
        <input type="password" name="password" placeholder="Create Password" required>
        <button type="submit" class="btn-block secondary">Register Now</button>
      </form>
      <p class="foot-note">Already have an account? <a href="/login">Login here</a></p>
    </div>
  </div>
</body>

</html>